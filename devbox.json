{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.6/.schema/devbox.schema.json",
  "packages": [
    "swift@6.2.4",
    "swiftPackages.swiftpm@6.2.4",
    "apple-sdk_26@26.5",
    "docker@latest",
    "swiftlint@latest",
    "swift-format@6.2.4"
  ],
  "env": {
    "SDKROOT": "$DEVBOX_PACKAGES_DIR/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk"
  },
  "shell": {
    "scripts": {
      "build":            "swift build",
      "test":             "swift test",
      "test:unit":        "swift test --filter TestcontainersCoreTests",
      "test:integration": "swift test --filter TestcontainersComposeTests",
      "lint":             "swiftlint lint --strict Sources Tests",
      "lint:fix":         "swiftlint --fix Sources Tests",
      "format":           "swift format --recursive --in-place Sources Tests",
      "format:check":     "swift format lint --recursive Sources Tests",
      "doc":              "swift package generate-documentation"
    }
  }
}
